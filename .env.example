# Postgres connection string. Port 5433 matches docker-compose.yml's mapping.
DATABASE_URL=postgresql://username:password@localhost:5433/job_scheduler

# Used by docker-compose.yml to provision the postgres container.
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=job_scheduler

# --- API -------------------------------------------------------------------

PORT=3000

# Required on POST/PUT/DELETE as the x-api-key header. Leave blank to keep
# writes unauthenticated (fine locally, not on a public deployment).
API_KEY=

# Comma-separated CORS allowlist, e.g. https://your-dashboard.onrender.com
# Blank reflects any origin, which is what local development needs.
ALLOWED_ORIGINS=

# Set to true to skip the automatic migration run on API boot.
SKIP_MIGRATIONS=

# --- Worker ----------------------------------------------------------------

# true makes the API process also poll for and execute due jobs. Needed when
# one service has to do both jobs; leave unset when running a dedicated worker.
RUN_WORKER=

# How long the simulated handler runs. The default of 60000 exists so a worker
# can be killed mid-job for the chaos test; set it low for anything else.
JOB_DURATION_MS=

POLL_INTERVAL_MS=2000
LEASE_DURATION_MS=15000
HEARTBEAT_INTERVAL_MS=5000

# --- Dashboard (web/, read at build time) ----------------------------------

# API base URL. Unset falls back to the Vite proxy locally.
VITE_API_URL=

# Must match API_KEY above, or the dashboard cannot write. Baked into the
# bundle, so treat it as public.
VITE_API_KEY=
